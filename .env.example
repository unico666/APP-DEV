# Shared by auth-server and blog-server. Copy to .env and change the secrets.
AUTH_PORT=4000
BLOG_PORT=5000

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=blog_platform

# SAME access secret in both servers (Blog API verifies what Auth Server signs)
JWT_ACCESS_SECRET=change-me-access-secret
# Only the Auth Server uses this one
JWT_REFRESH_SECRET=change-me-refresh-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

CLIENT_ORIGIN=http://localhost:5173
